# Environment variable inventory — no secret values, names and purposes only.
# See docs/Phase-1-Foundation-Execution-Plan.md §7 for the full audit.

# Core
DATABASE_URL=
NODE_ENV=
PORT=
BASE_PATH=
LOG_LEVEL=

# AI coach providers — Anthropic and OpenAI keys are kept separate.
# ANTHROPIC_API_KEY takes priority if set. OPENAI_API_KEY is also still
# accepted holding an Anthropic key (sk-ant- prefix) for backward
# compatibility with deployments that predate this split — coachLLM.ts logs
# a startup warning when that legacy path fires. Prefer ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_COACH_MODEL=
OPENAI_API_KEY=
OPENAI_COACH_MODEL=
COACH_LLM_TIMEOUT_MS=

# Auth (Better-Auth — Owner Decision #1, Phase 1 Sprint 6)
# BETTER_AUTH_SECRET is required; generate one with `openssl rand -base64 32`
# and never commit the real value. BETTER_AUTH_URL is this API server's own
# public base URL (used to construct callback/redirect URLs). CORS_ALLOWED_ORIGINS
# is a comma-separated list of frontend origins allowed to make credentialed
# (cookie-based) cross-origin requests — leave unset for same-origin-only
# deployments; must match Better-Auth's trustedOrigins (lib/auth/src/index.ts
# reads the same variable). Owner Decision #6 (production CORS origin list)
# is still unresolved, so there is no default value here to copy blindly.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
CORS_ALLOWED_ORIGINS=

# REQUIRE_AUTH (Phase 1 Sprint 7) — set to "true" to make requireAuth mandatory
# on every business route (401 without a valid session). Defaults to unset/false
# so existing single-tenant deployments keep working unchanged (every route
# falls back to the legacy-owner stand-in via getScopedUserId when no session
# exists) until you've verified sign-in end-to-end. Health checks are always
# exempt regardless of this setting.
REQUIRE_AUTH=

# Brokerage
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Fundamentals
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Market data (currently unused by polygonProvider.ts — not yet wired)
POLYGON_API_KEY=

# Platform
REPL_ID=
