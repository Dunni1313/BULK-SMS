# Environment variable inventory — no secret values, names and purposes only.
# See docs/Phase-1-Foundation-Execution-Plan.md §7 for the full audit.

# Core
DATABASE_URL=
NODE_ENV=
PORT=
BASE_PATH=
LOG_LEVEL=

# AI coach providers — Anthropic and OpenAI keys are kept separate.
# ANTHROPIC_API_KEY takes priority if set. OPENAI_API_KEY is also still
# accepted holding an Anthropic key (sk-ant- prefix) for backward
# compatibility with deployments that predate this split — coachLLM.ts logs
# a startup warning when that legacy path fires. Prefer ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_COACH_MODEL=
OPENAI_API_KEY=
OPENAI_COACH_MODEL=
COACH_LLM_TIMEOUT_MS=

# Brokerage
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Fundamentals
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=

# Market data (currently unused by polygonProvider.ts — not yet wired)
POLYGON_API_KEY=

# Platform
REPL_ID=
